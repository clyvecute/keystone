# Cloud Provider Configuration
# GCP
GCP_PROJECT_ID=project-1ca031fa-daa9-40ae-878
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Terraform Backend
TF_STATE_BUCKET=keystone-tf-state-project-1ca031fa-daa9-40ae-878-dev
TF_STATE_PREFIX=terraform/state

# Application Configuration
APP_NAME=configra
APP_ENV=dev
APP_PORT=8080

# Database
DB_NAME=configra
DB_USER=configra_user

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_BUCKET=keystone-backups-project-1ca031fa-daa9-40ae-878

# Feature Flags
ENABLE_MONITORING=true
ENABLE_AUTO_BACKUP=true
ENABLE_ALERTS=true
ENABLE_BINARY_AUTHORIZATION=false

# Security
KMS_KEY_NAME=
WIF_PROVIDER=
WIF_SERVICE_ACCOUNT=
SLACK_WEBHOOK=
